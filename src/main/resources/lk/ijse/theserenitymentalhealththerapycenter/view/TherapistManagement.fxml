<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.TherapistManagementController">
    <VBox spacing="20" style="-fx-padding: 28;">
        <!-- Form Card -->
        <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 24; -fx-background-radius: 16; -fx-border-color: #E5DFD8; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.05), 8, 0, 0, 2);">
            <Label style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold;" text="👨‍⚕️  Therapist Details" />
            <Separator />
         <HBox fx:id="hBoxSelectedTherapist" alignment="CENTER_LEFT" layoutX="35.0" layoutY="83.0" spacing="16">
            <children>
               <VBox maxWidth="200.0" minWidth="100.0" spacing="4" HBox.hgrow="ALWAYS">
                  <children>
                     <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="THERAPIST ID" />
                     <TextField fx:id="txtTherapistId" editable="false" promptText="Therapist Id" />
                  </children>
               </VBox>
               <Region HBox.hgrow="ALWAYS" />
               <Button fx:id="btnTherapistSchedule" onAction="#handleTherapistSchedule" style="-fx-background-color: #4A7FA5; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 10; -fx-cursor: hand;" text="Therapist Schedule" />
            </children>
         </HBox>
            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="FULL NAME" />
                    <TextField fx:id="txtTherapistName" promptText="Enter therapist name" />
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="SPECIALTY" />
                    <TextField fx:id="txtTherapistSpecialty" promptText="e.g. CBT, Family Therapy" />
                </VBox>
            </HBox>
            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="PHONE" />
                    <TextField fx:id="txtTherapistPhone" promptText="Phone number" />
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="EMAIL" />
                    <TextField fx:id="txtTherapistEmail" promptText="Email address" />
                </VBox>
                <VBox spacing="4">
                    <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="STATUS" />
                    <ComboBox fx:id="cmbTherapistStatus" prefWidth="160" promptText="Select status" />
                </VBox>
            </HBox>
            <VBox spacing="4">
                <Label style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="ASSIGNED THERAPY PROGRAMS" />
                <ScrollPane fitToWidth="true" prefHeight="80" style="-fx-background-color: transparent;">
                    <FlowPane fx:id="flowPrograms" hgap="16" style="-fx-padding: 8; -fx-background-color: #FAF8F5; -fx-border-color: #E5DFD8; -fx-border-radius: 8; -fx-background-radius: 8;" vgap="8" />
                </ScrollPane>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnSaveTherapist" onAction="#handleSaveTherapist" style="-fx-padding: 10 24;" styleClass="btn-primary" text="💾  Save" />
                <Button fx:id="btnUpdateTherapist" onAction="#handleUpdateTherapist" styleClass="btn-secondary" text="✏️  Update" />
                <Button fx:id="btnClearTherapist" onAction="#handleClearTherapist" styleClass="btn-secondary" text="🔄  Clear" />
            </HBox>
        </VBox>

        <!-- Table Card -->
        <VBox spacing="0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5DFD8; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.05), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 20 20 16 20;">
                <Label style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold;" text="Therapist Records" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearchTherapist" prefWidth="220" promptText="🔍  Search..." style="-fx-background-color: #F5F0EB; -fx-border-color: transparent; -fx-background-radius: 10; -fx-padding: 8 12; -fx-font-size: 12px;" />
                <Button onAction="#handleDeleteTherapist" style="-fx-background-color: #C47171; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 10; -fx-cursor: hand;" text="🗑  Delete" />
            </HBox>
            <Separator />
            <TableView fx:id="tblTherapists" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colTherapistId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colTherapistName" prefWidth="180" text="Full Name" />
                    <TableColumn fx:id="colTherapistSpecialty" prefWidth="160" text="Specialty" />
                    <TableColumn fx:id="colTherapistPhone" prefWidth="130" text="Phone" />
                    <TableColumn fx:id="colTherapistEmail" prefWidth="180" text="Email" />
                    <TableColumn fx:id="colTherapistStatus" prefWidth="100" text="Status" />
                </columns>
                <placeholder><Label style="-fx-text-fill: #95A5A6; -fx-font-size: 13px;" text="No therapists found." /></placeholder>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
