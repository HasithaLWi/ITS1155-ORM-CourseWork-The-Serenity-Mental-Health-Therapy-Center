	<queryString language="SQL">
		<![CDATA[SELECT 
    tp.id AS program_id,
    tp.name AS program_name,
    tp.duration AS program_duration,
    tp.fee AS program_fee,
    COUNT(ptp.id) AS enrolled_count
FROM therapy_programs tp
LEFT JOIN patient_therapy_programs ptp ON tp.id = ptp.program_id
GROUP BY tp.id, tp.name, tp.duration, tp.fee
ORDER BY enrolled_count DESC]]>
	</queryString>
	<field name="program_id" class="java.lang.Long"/>
	<field name="program_name" class="java.lang.String"/>
	<field name="program_duration" class="java.lang.String"/>
	<field name="program_fee" class="java.math.BigDecimal"/>
	<field name="enrolled_count" class="java.lang.Long"/>
