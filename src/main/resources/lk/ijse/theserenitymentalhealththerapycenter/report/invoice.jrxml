	<parameter name="payment_id" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    p.id AS payment_id, 
    p.amount, 
    p.payment_date, 
    p.method, 
    p.payment_type, 
    p.discount, 
    p.description, 
    pat.name AS patient_name, 
    pat.email AS patient_email, 
    pat.phone AS patient_phone
FROM payments p
INNER JOIN patients pat ON p.patient_id = pat.id
WHERE p.id = $P{payment_id}]]>
	</queryString>
	<field name="payment_id" class="java.lang.Long"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="payment_date" class="java.sql.Timestamp"/>
	<field name="method" class="java.lang.String"/>
