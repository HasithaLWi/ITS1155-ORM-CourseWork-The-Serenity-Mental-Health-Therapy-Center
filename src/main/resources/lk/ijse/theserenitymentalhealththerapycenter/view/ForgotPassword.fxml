<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="800" prefWidth="1280" style="-fx-background-color: linear-gradient(to bottom right, #FAF8F5, #F0ECE6);" stylesheets="@../style/calm-clarity.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.ForgotPasswordController">

    <!-- ═══════════ LEFT BRANDING PANEL ═══════════ -->
    <VBox alignment="CENTER" spacing="12" style="-fx-background-color: rgba(139,175,158,0.08); -fx-min-width: 480;" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="60" left="60" right="60" top="60" />
        </padding>
      <ImageView fitHeight="269.0" fitWidth="386.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/logo3.png" />
         </image>
      </ImageView>

        <Region prefHeight="16" />

        <Label style="-fx-text-fill: #2D3436; -fx-font-size: 42px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Serenity" />
        <Label style="-fx-text-fill: #636E72; -fx-font-size: 16px; -fx-font-family: 'Segoe UI';" text="Mental Health Therapy Center" />

        <Region prefHeight="24" />

        <Separator maxWidth="200" style="-fx-background-color: #E5DFD8;" />

        <Region prefHeight="12" />

        <Label alignment="CENTER" maxWidth="300" style="-fx-text-fill: #8BAF9E; -fx-font-size: 13px; -fx-font-style: italic; -fx-font-family: 'Segoe UI';" text="Don't worry, we'll help you recover access." wrapText="true" />

        <Label alignment="CENTER" maxWidth="300" style="-fx-text-fill: #95A5A6; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="Your security is our priority." wrapText="true" />
    </VBox>

    <!-- ═══════════ RIGHT RESET PANEL ═══════════ -->
    <VBox alignment="CENTER" style="-fx-min-width: 520;" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="40" left="80" right="80" top="40" />
        </padding>

        <!-- Reset Card -->
        <VBox alignment="CENTER" maxWidth="420" spacing="6" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #E5DFD8; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.08), 20, 0, 0, 6);">
            <padding>
                <Insets bottom="36" left="44" right="44" top="40" />
            </padding>

            <!-- Header -->
            <Label style="-fx-text-fill: #2D3436; -fx-font-size: 26px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Reset Password" />
            <Label style="-fx-text-fill: #95A5A6; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="Follow the steps to recover your account" />

            <Region prefHeight="12" />

            <!-- Step indicators -->
            <HBox alignment="CENTER" spacing="24">
                <Label fx:id="step1Indicator" style="-fx-text-fill: #4A7FA5; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="1" />
                <Label style="-fx-text-fill: #E5DFD8; -fx-font-size: 18px;" text="─" />
                <Label fx:id="step2Indicator" style="-fx-text-fill: #95A5A6; -fx-font-size: 28px; -fx-font-family: 'Segoe UI';" text="2" />
                <Label style="-fx-text-fill: #E5DFD8; -fx-font-size: 18px;" text="─" />
                <Label fx:id="step3Indicator" style="-fx-text-fill: #95A5A6; -fx-font-size: 28px; -fx-font-family: 'Segoe UI';" text="3" />
            </HBox>

            <Region prefHeight="16" />
            <Separator />
            <Region prefHeight="12" />

            <!-- ═══ STEP 1: Identity Verification ═══ -->
            <VBox fx:id="step1Pane" spacing="6">
                <Label style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Step 1: Verify Your Identity" />

                <Region prefHeight="8" />

                <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="USERNAME" />
                <TextField fx:id="txtUsername" promptText="Enter your username" />

                <Region prefHeight="4" />

                <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="EMAIL ADDRESS" />
                <TextField fx:id="txtEmail" promptText="Enter your email address" />

                <Region prefHeight="4" />

                <Label fx:id="lblStep1Error" alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #C47171; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="" wrapText="true" />

                <Region prefHeight="4" />

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleVerifyIdentity" styleClass="btn-primary" text="Verify Identity" />
            </VBox>

            <!-- ═══ STEP 2: Email OTP Verification ═══ -->
            <VBox fx:id="step2Pane" managed="false" spacing="6" visible="false">
                <Label style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Step 2: Email OTP Verification" />

                <Region prefHeight="8" />

                <Label fx:id="lblSecurityQuestion" maxWidth="Infinity" style="-fx-text-fill: #636E72; -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="Enter the 6-digit One-Time Password (OTP) sent to your registered email address." wrapText="true" />

                <TextField fx:id="txtSecurityAnswer" promptText="Enter 6-digit OTP" />

                <Region prefHeight="4" />

                <Label fx:id="lblStep2Error" alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #C47171; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="" wrapText="true" />

                <Region prefHeight="4" />

                <HBox spacing="10">
                    <Button maxWidth="Infinity" onAction="#handleBackToStep1" styleClass="btn-secondary" text="← Back" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#handleVerifyAnswer" styleClass="btn-primary" text="Verify OTP" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- ═══ STEP 3: New Password ═══ -->
            <VBox fx:id="step3Pane" managed="false" spacing="6" visible="false">
                <Label style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Step 3: Set New Password" />

                <Region prefHeight="8" />

                <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="NEW PASSWORD" />
                <PasswordField fx:id="txtNewPassword" promptText="Min 6 characters" />

                <Region prefHeight="4" />

                <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: #8BAF9E; -fx-font-size: 10px; -fx-font-weight: bold;" text="CONFIRM PASSWORD" />
                <PasswordField fx:id="txtConfirmNewPassword" promptText="Repeat new password" />

                <Region prefHeight="4" />

                <Label fx:id="lblStep3Error" alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #C47171; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="" wrapText="true" />

                <Region prefHeight="4" />

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleResetPassword" styleClass="btn-primary" text="Reset Password" />
            </VBox>

            <Region prefHeight="12" />

            <Separator />

            <Region prefHeight="8" />

            <!-- Back to Login -->
            <HBox alignment="CENTER" spacing="4">
                <Label style="-fx-text-fill: #95A5A6; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';" text="Remember your password?" />
                <Hyperlink onAction="#handleBackToLogin" style="-fx-text-fill: #4A7FA5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-border-color: transparent;" text="Sign In" />
            </HBox>

            <Region prefHeight="4" />
        </VBox>
    </VBox>
</HBox>
