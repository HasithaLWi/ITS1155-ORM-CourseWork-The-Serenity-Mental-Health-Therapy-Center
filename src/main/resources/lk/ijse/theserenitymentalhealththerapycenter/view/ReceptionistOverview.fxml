<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.ReceptionistOverviewController"
            fitToWidth="true" style="-fx-background-color: transparent;">
    <VBox spacing="24" style="-fx-padding: 28;">
        <!-- Stats Cards -->
        <HBox spacing="16">
            <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 16; -fx-border-color: #E5DFD8; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.05), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🧑‍🤝‍🧑" style="-fx-font-size: 22px; -fx-background-color: #E8F1F8; -fx-padding: 10; -fx-background-radius: 12;"/>
                    <VBox>
                        <Label text="Total Patients" style="-fx-text-fill: #95A5A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalPatients" text="0" style="-fx-text-fill: #2D3436; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 16; -fx-border-color: #E5DFD8; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.05), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📅" style="-fx-font-size: 22px; -fx-background-color: #E8F2ED; -fx-padding: 10; -fx-background-radius: 12;"/>
                    <VBox>
                        <Label text="Scheduled Sessions" style="-fx-text-fill: #95A5A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTodaySessions" text="0" style="-fx-text-fill: #2D3436; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Scheduled Sessions Table -->
        <VBox spacing="0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5DFD8; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.05), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 20 20 16 20;">
                <Label text="📅  Scheduled Sessions (Sorted by Date)" style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            </HBox>
            <Separator/>
            <TableView fx:id="tblTodaySessions" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colTodayDate" text="Date" prefWidth="110"/>
                    <TableColumn fx:id="colTodayTime" text="Time" prefWidth="100"/>
                    <TableColumn fx:id="colTodayPatient" text="Patient" prefWidth="180"/>
                    <TableColumn fx:id="colTodayPhone" text="Patient Phone" prefWidth="130"/>
                    <TableColumn fx:id="colTodayTherapist" text="Therapist" prefWidth="180"/>
                    <TableColumn fx:id="colTodayProgram" text="Program" prefWidth="200"/>
                    <TableColumn fx:id="colTodayStatus" text="Status" prefWidth="120"/>
                </columns>
                <placeholder><Label text="No active scheduled sessions." style="-fx-text-fill: #95A5A6; -fx-font-size: 13px;"/></placeholder>
            </TableView>
        </VBox>

        <!-- Patients with No Scheduled Sessions Table -->
        <VBox spacing="0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5DFD8; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(45,52,54,0.05), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 20 20 16 20;">
                <Label text="🧑‍🤝‍🧑  Patients with No Scheduled Sessions" style="-fx-text-fill: #2D3436; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            </HBox>
            <Separator/>
            <TableView fx:id="tblUnscheduledPatients" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colUnscheduledId" text="Patient ID" prefWidth="100"/>
                    <TableColumn fx:id="colUnscheduledName" text="Name" prefWidth="185"/>
                    <TableColumn fx:id="colUnscheduledPhone" text="Phone" prefWidth="130"/>
                    <TableColumn fx:id="colUnscheduledEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colUnscheduledDate" text="Registered Date" prefWidth="130"/>
                </columns>
                <placeholder><Label text="All active patients have at least one scheduled session." style="-fx-text-fill: #95A5A6; -fx-font-size: 13px;"/></placeholder>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
